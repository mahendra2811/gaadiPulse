# EAS uses this file instead of .gitignore. Keep the existing Git exclusions.
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.pem
.env
.env.*
*.tsbuildinfo
/android/
/ios/
/supabase-email-templates/

# Local build artifacts, credentials, caches, and editor files.
*.aab
*.apk
*.ipa
/credentials.json
.git
/.vscode/
/coverage/

# Documentation, backend sources, and tests are not needed to build the app.
/docs/
/my docs/
/supabase/
/tests/
/config/*
!/config/vehicle-catalog.seed.json
/AGENTS.md
/PROJECT_REFERENCE.md
/ANDROID_RELEASE_COMMANDS.md
/README.md
/tsconfig.test.json
/vitest.config.mts
