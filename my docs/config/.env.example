# Copy to repository root as .env when Codex initializes the Expo project.
# EXPO_PUBLIC values ship in the application bundle; NEVER use secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
EXPO_PUBLIC_APP_SCHEME=gaadipulse
EXPO_PUBLIC_APP_ENV=development
# Optional nonsecret telemetry configuration after privacy review
EXPO_PUBLIC_SENTRY_DSN=

# Server-side ONLY — configure via Supabase Edge Function secrets, never in Expo client:
# EMAIL_API_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
